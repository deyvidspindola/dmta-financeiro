#!/usr/bin/env bash
#
# Hook de pre-commit do template. Instalado por `make setup`.
# Roda o portão de qualidade antes de cada commit.
#
# Para pular em caso excepcional:  git commit --no-verify
# Se você estiver usando isso com frequência, o problema é a regra, não o hook.

set -e

# O .git é compartilhado entre todos os worktrees do monorepo (git
# rev-parse --git-common-dir) — este hook dispara pra commit em
# qualquer um deles, não só em apps/api. Só faz sentido rodar o
# make check da API quando o commit de fato mexe em apps/api; caso
# contrário (ex.: commit só em apps/web) ele bloquearia por um
# `make check` de código que nem mudou.
TOPLEVEL="$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only | grep -q '^apps/api/'; then
    exit 0
fi

cd "$TOPLEVEL/apps/api"

if ! docker compose ps --status running --quiet app > /dev/null 2>&1; then
    echo ""
    echo "  ⚠  contêineres não estão rodando — 'make up' antes de commitar"
    echo ""
    exit 1
fi

echo ""
echo "  Verificando padrões antes do commit (apps/api)..."
echo ""

make check
