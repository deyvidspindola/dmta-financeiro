APP_NAME="DMTA Financeiro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Container "db" do docker-compose.yml — porta 3307 no host evita conflito
# com um MySQL local. Dentro da rede Docker o app fala com "db:3306".
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_base
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fila via "database", processada só pelo scheduler (schedule:run a cada
# minuto). Nunca queue:work como serviço permanente — hospedagem compartilhada
# não sustenta processo contínuo.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit local (docker-compose.yml) — UI em http://localhost:8027
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Domínios autorizados a autenticar via cookie de sessão (SPA). Tokens
# pessoais do Sanctum (Bearer, ver /admin/tokens) não dependem disto.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8000

# Bot do Telegram (F1, D-06) — deixe TELEGRAM_BOT_TOKEN em branco pra
# desligar (o webhook fica de pé mas não processa nada). Crie o bot via
# @BotFather, configure o webhook pra apontar pra
# /api/v1/webhooks/telegram com o secret_token abaixo, e informe o
# chat_id (só ele é atendido — uso pessoal, D-11) e o e-mail do usuário
# dono das contas.
#
# Alternativa: preencher tudo isto pela tela (PUT /api/v1/integrations,
# App\Models\IntegrationSettings) — o valor do banco tem precedência
# sobre estas variáveis. Deixe em branco aqui e configure pela tela.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_USER_EMAIL=

# Sentry — deixe o DSN em branco para desligar o envio. Preencha em
# staging/produção (e localmente quando for testar o monitoramento).
SENTRY_LARAVEL_DSN=
# 1.0 em desenvolvimento; em produção use um valor baixo (ex.: 0.1).
SENTRY_TRACES_SAMPLE_RATE=1.0
# Nível mínimo de Log::() explícito que também vira evento no Sentry
# (LOG_STACK precisa incluir "sentry" — ver config/logging.php).
SENTRY_LOG_LEVEL=warning

# Captura de boleto por e-mail (F1, D-06) — desligado por padrão.
# Também configurável pela tela (PUT /api/v1/integrations) — o valor do
# banco tem precedência sobre estas variáveis.
BOLETO_MAILBOX_ENABLED=false
BOLETO_MAILBOX_HOST=
BOLETO_MAILBOX_PORT=993
BOLETO_MAILBOX_ENCRYPTION=ssl
BOLETO_MAILBOX_USERNAME=
BOLETO_MAILBOX_PASSWORD=
