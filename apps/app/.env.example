# Copie para `.env` (ou `.env.local`) — o Expo embute variáveis EXPO_PUBLIC_*
# no bundle em dev/build. Ver apps/app/README.md.

# Base da API Laravel versionada (Sanctum). Sem barra no fim.
# Dev local (Docker do apps/api):    http://localhost:8000/api/v1
# No device físico use o IP da máquina: http://192.168.x.x:8000/api/v1
# Produção:                           https://financeiro.dmta.dev.br/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
